# Documentation only. This program does not automatically read .env files.
OGH_PROVIDER=mock
OGH_STORAGE=mock
# For encrypted persistence, supply local and a private absolute path/key.
# OGH_STORAGE=local
# OGH_STORAGE_DIR=/private/path/rosters
# OGH_STORAGE_KEY=64_HEX_CHARACTERS_FROM_YOUR_SECRET_MANAGER
OGH_CACHE_TTL_MS=3600000
OGH_AUTH_MODE=local
OGH_HOST=127.0.0.1
PORT=3000
# Required for local HTTP, not stdio. Generate privately, at least 32 characters.
# OGH_DEV_TOKEN=PRIVATE_RANDOM_TOKEN
# Remote hosting requires all OAuth settings and durable local storage:
# OGH_AUTH_MODE=oauth
# OGH_HOST=0.0.0.0
# OGH_PUBLIC_URL=https://your-approved-host.example/mcp
# OGH_ISSUER=https://your-authorization-server.example/
# OGH_JWKS_URL=https://your-authorization-server.example/jwks
# OGH_ALLOWED_SUBJECTS=your-approved-owner-subject
# OGH_ALLOWED_ORIGINS=https://explicitly-approved-client.example
# Never put GHIN credentials here. Live access is disabled.
